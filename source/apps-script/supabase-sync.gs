const HDK={PROP_URL:'HDK_SUPABASE_FUNCTION_URL',PROP_TOKEN:'HDK_SUPABASE_SYNC_TOKEN',PROP_STATE_SS:'HDK_STATE_SPREADSHEET_ID',STATE_SHEET:'HDK_SYNC_STATE',QUEUE_SHEET:'HDK_SYNC_QUEUE',BATCH:250,SCAN:500,MAX_RUNTIME_MS:240000};

function HDK_configurarSupabase(url,token){PropertiesService.getScriptProperties().setProperties({[HDK.PROP_URL]:String(url||'').replace(/\/$/,''),[HDK.PROP_TOKEN]:String(token||'')});}
function HDK_configurarPlanilhaEstado(planilhaId){const id=String(planilhaId||'').trim();if(!id)throw new Error('Informe o ID da planilha que armazenará HDK_SYNC_STATE e HDK_SYNC_QUEUE.');SpreadsheetApp.openById(id);PropertiesService.getScriptProperties().setProperty(HDK.PROP_STATE_SS,id);return{ok:true,planilhaEstadoId:id};}
function HDK_iso_(value){if(value instanceof Date&&!isNaN(value))return value.toISOString();const text=String(value==null?'':value).trim();return text||null;}
function HDK_text_(value){return String(value==null?'':value).trim();}
function HDK_dateOnly_(value,timeZone){if(value instanceof Date&&!isNaN(value))return Utilities.formatDate(value,timeZone,'yyyy-MM-dd');const text=HDK_text_(value);const br=text.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);if(br)return`${br[3]}-${br[2].padStart(2,'0')}-${br[1].padStart(2,'0')}`;return/^\d{4}-\d{2}-\d{2}/.test(text)?text.slice(0,10):null;}
function HDK_timeOnly_(value,displayValue,timeZone){const shown=HDK_text_(displayValue),match=shown.match(/(?:^|\s)(\d{1,2}):(\d{2})(?::(\d{2}))?/);if(match)return`${match[1].padStart(2,'0')}:${match[2]}:${match[3]||'00'}`;if(value instanceof Date&&!isNaN(value))return Utilities.formatDate(value,timeZone,'HH:mm:ss');return null;}
function HDK_canonical_(object){const sorted={};Object.keys(object).sort().forEach(key=>{if(!['source_updated_at','synced_at','updated_at','linha_origem'].includes(key))sorted[key]=object[key]===undefined?null:object[key];});return JSON.stringify(sorted);}
function HDK_hash_(object){const bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,HDK_canonical_(object),Utilities.Charset.UTF_8);return bytes.map(b=>((b+256)%256).toString(16).padStart(2,'0')).join('');}
function HDK_idempotency_(entity,items){return HDK_hash_({entity,items:items.map(x=>({key:entity==='FORNO'?x.n_serie:x.id_origem,row_hash:x.row_hash})).sort((a,b)=>String(a.key).localeCompare(String(b.key)))});}
function HDK_headers_(sheet){const last=sheet.getLastColumn(),values=sheet.getRange(1,1,1,last).getDisplayValues()[0],map={};values.forEach((h,i)=>map[normalizarCabecalho_(h)]=i);return{last,map};}
function HDK_field_(row,map,name){const index=map[normalizarCabecalho_(name)];return index===undefined?'':row[index];}

function HDK_lerApontamentos_(sheet,firstRow,count){if(count<=0)return[];const meta=HDK_headers_(sheet),range=sheet.getRange(firstRow,1,count,meta.last),raw=range.getValues(),shown=range.getDisplayValues(),timeZone=sheet.getParent().getSpreadsheetTimeZone()||'America/Sao_Paulo';return raw.map((row,index)=>{const get=name=>HDK_field_(row,meta.map,name),getShown=name=>HDK_field_(shown[index],meta.map,name),dataProdutiva=HDK_dateOnly_(get('DATA'),timeZone)||HDK_dateOnly_(get('DATA_HORA'),timeZone),horaInicial=HDK_timeOnly_(get('HORA INICIAL'),getShown('HORA INICIAL'),timeZone),horaFinal=HDK_timeOnly_(get('HORA FINAL'),getShown('HORA FINAL'),timeZone),item={id_origem:HDK_text_(get('ID')),n_serie:HDK_text_(get('N_SERIE')),modelo_origem:HDK_text_(get('MODELO'))||null,cliente_origem:HDK_text_(get('CLIENTE'))||null,operacao:HDK_text_(get('OPERAÇÃO'))||null,operador:HDK_text_(get('OPERADOR'))||null,data_hora:HDK_iso_(get('DATA_HORA')),data_produtiva:dataProdutiva,hora_inicial_local:horaInicial,hora_final_local:horaFinal,horario_status:dataProdutiva&&(horaInicial||horaFinal)?'CONFIAVEL_ORIGEM':'INVALIDO',tempo_perdido:HDK_text_(get('TEMPO PERDIDO'))||null,parcial:HDK_text_(get('PARCIAL'))||null,observacao:HDK_text_(get('OBS'))||null,tempo_total:HDK_text_(get('TEMPO TOTAL'))||null,source_deleted:false,linha_origem:firstRow+index};item.row_hash=HDK_hash_(item);return item;}).filter(x=>x.id_origem);}
function HDK_fornoPayload_(venda,index){const item={source_id:HDK_text_(venda.id)||null,n_serie:HDK_text_(venda.idVenda),cliente:HDK_text_(venda.cliente)||null,modelo:HDK_text_(venda.modelo)||null,data_venda:HDK_iso_(venda.dataVenda),data_entrega:HDK_iso_(venda.dataEntrega),prazo:venda.prazo===''||venda.prazo==null?null:Number(venda.prazo),bancada:HDK_text_(venda.bancada)||null,tensao:HDK_text_(venda.tensao)||null,controlador:HDK_text_(venda.controlador)||null,observacao:HDK_text_(venda.observacao)||null,status_caixa:HDK_text_(venda.statusCaixa)||'COMPRAR',status_forno:HDK_text_(venda.statusForno)||'FABRICAÇÃO',linha_origem:index+2};item.row_hash=HDK_hash_(item);return item;}

function HDK_enviar_(action,data,origem,idempotency){const p=PropertiesService.getScriptProperties(),url=p.getProperty(HDK.PROP_URL),token=p.getProperty(HDK.PROP_TOKEN);if(!url||!token)throw new Error('Configure HDK_SUPABASE_FUNCTION_URL e HDK_SUPABASE_SYNC_TOKEN.');const response=UrlFetchApp.fetch(url,{method:'post',contentType:'application/json',muteHttpExceptions:true,headers:{'x-hd-sync-token':token,'x-idempotency-key':idempotency},payload:JSON.stringify({action,data,origem,idempotency_key:idempotency})}),text=response.getContentText();if(response.getResponseCode()>=300)throw new Error(text);const parsed=JSON.parse(text);if(!parsed.ok)throw new Error(parsed.error||text);return parsed;}

function HDK_stateSpreadsheet_(){const props=PropertiesService.getScriptProperties(),configured=String(props.getProperty(HDK.PROP_STATE_SS)||'').trim();if(configured)return SpreadsheetApp.openById(configured);const active=SpreadsheetApp.getActiveSpreadsheet();if(active)return active;throw new Error('Planilha de estado não configurada. Execute HDK_configurarPlanilhaEstado("ID_DA_PLANILHA") uma vez. Em projetos independentes, getActiveSpreadsheet() não é confiável.');}
function HDK_sheet_(name,headers){const ss=HDK_stateSpreadsheet_(),sheet=ss.getSheetByName(name)||ss.insertSheet(name);if(sheet.getLastRow()===0)sheet.getRange(1,1,1,headers.length).setValues([headers]);if(!sheet.isSheetHidden())sheet.hideSheet();return sheet;}
function HDK_validarDependencias_(){const missing=[];if(typeof HDK!=='object')missing.push('HDK');if(typeof HDK_stateMap_!=='function')missing.push('HDK_stateMap_');if(typeof HDK_sheet_!=='function')missing.push('HDK_sheet_');if(typeof HDK_sendChanged_!=='function')missing.push('HDK_sendChanged_');if(typeof HDK_lerApontamentos_!=='function')missing.push('HDK_lerApontamentos_');if(typeof HDK_fornoPayload_!=='function')missing.push('HDK_fornoPayload_');if(typeof HDK_enviar_!=='function')missing.push('HDK_enviar_');if(typeof HDK_hash_!=='function')missing.push('HDK_hash_');if(typeof normalizarCabecalho_!=='function')missing.push('normalizarCabecalho_ (Code.gs)');if(missing.length)throw new Error('Integração incompleta. Copie integralmente supabase-sync.gs e supabase-reconcile.gs para o mesmo projeto Apps Script. Dependências ausentes: '+missing.join(', ')+'.');const props=PropertiesService.getScriptProperties(),problems=[];if(!props.getProperty(HDK.PROP_URL))problems.push(HDK.PROP_URL);if(!props.getProperty(HDK.PROP_TOKEN))problems.push(HDK.PROP_TOKEN);if(!props.getProperty(HDK.PROP_STATE_SS)&&!SpreadsheetApp.getActiveSpreadsheet())problems.push(HDK.PROP_STATE_SS);if(problems.length)throw new Error('Configuração incompleta nas Propriedades do script: '+problems.join(', ')+'.');return{ok:true,planilhaEstadoId:HDK_stateSpreadsheet_().getId(),lote:HDK.BATCH,varredura:HDK.SCAN};}
function HDK_stateMap_(){const sheet=HDK_sheet_(HDK.STATE_SHEET,['ENTIDADE','CHAVE','HASH','LINHA','ATUALIZADO_EM']),map=new Map();if(sheet.getLastRow()>1)sheet.getRange(2,1,sheet.getLastRow()-1,5).getValues().forEach((r,i)=>map.set(`${r[0]}|${r[1]}`,{hash:String(r[2]),row:i+2}));return{sheet,map};}
function HDK_changed_(entity,items,state){return items.filter(item=>state.map.get(`${entity}|${entity==='FORNO'?item.n_serie:item.id_origem}`)?.hash!==item.row_hash);}
function HDK_commitState_(entity,items,state){if(!items.length)return;const now=new Date(),append=[];items.forEach(item=>{const key=entity==='FORNO'?item.n_serie:item.id_origem,existing=state.map.get(`${entity}|${key}`),values=[entity,key,item.row_hash,item.linha_origem||'',now];if(existing)state.sheet.getRange(existing.row,1,1,5).setValues([values]);else{append.push(values);state.map.set(`${entity}|${key}`,{hash:item.row_hash,row:state.sheet.getLastRow()+append.length});}});if(append.length)state.sheet.getRange(state.sheet.getLastRow()+1,1,append.length,5).setValues(append);}
function HDK_queue_(entity,items,origin,error){const sheet=HDK_sheet_(HDK.QUEUE_SHEET,['IDEMPOTENCIA','ENTIDADE','ORIGEM','PAYLOAD','TENTATIVAS','PROXIMA_TENTATIVA','ERRO']);const now=Date.now(),rows=items.map(item=>[HDK_idempotency_(entity,[item]),entity,origin,JSON.stringify(item),1,new Date(now+5*60000),String(error).slice(0,1000)]);if(rows.length)sheet.getRange(sheet.getLastRow()+1,1,rows.length,7).setValues(rows);}
function HDK_sendChanged_(entity,items,origin,state){const totals={lidos:items.length,enviados:0,inseridos:0,atualizados:0,ignorados:0,erros:0};for(let i=0;i<items.length;i+=HDK.BATCH){const batch=items.slice(i,i+HDK.BATCH),key=HDK_idempotency_(entity,batch),sentAt=new Date().toISOString(),payload=batch.map(item=>Object.assign({},item,{source_updated_at:sentAt}));try{const response=HDK_enviar_(entity==='FORNO'?'sync-fornos-batch':'sync-apontamentos-batch',payload,origin,key),result=response.result||{};HDK_commitState_(entity,batch,state);totals.enviados+=batch.length;totals.inseridos+=Number(result.inseridos||0);totals.atualizados+=Number(result.atualizados||0);totals.ignorados+=Number(result.ignorados||0);}catch(error){totals.erros+=batch.length;HDK_queue_(entity,payload,origin,error);}}return totals;}

function HDK_syncFornoSeguro_(venda){const state=HDK_stateMap_(),item=HDK_fornoPayload_(venda,0),changed=HDK_changed_('FORNO',[item],state),result=HDK_sendChanged_('FORNO',changed,'HD_VENDAS_EVENTO',state);return{ok:result.erros===0,enviados:result.enviados,ignorados:changed.length?result.ignorados:1,erros:result.erros};}
function HDK_syncApontamentosLinhasSeguro_(sheet,firstRow,count,origin){const lock=LockService.getScriptLock();if(!lock.tryLock(5000))return{ok:false,erro:'Sincronização já em andamento.'};try{const state=HDK_stateMap_(),items=HDK_lerApontamentos_(sheet,Math.max(2,firstRow),count),changed=HDK_changed_('APONTAMENTO',items,state),result=HDK_sendChanged_('APONTAMENTO',changed,origin||'GOOGLE_SHEETS',state);return{ok:result.erros===0,lidos:items.length,enviados:result.enviados,ignorados:items.length-changed.length+result.ignorados,erros:result.erros};}finally{lock.releaseLock();}}


