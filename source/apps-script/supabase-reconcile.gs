/** HD Medeiros — varredura incremental e reprocessamento seletivo. Adicionar este arquivo. */
function HDK_instalarGatilhos(){const handlers=['HDK_sincronizacaoIncremental','HDK_reprocessarPendencias','HDK_reconciliacaoDiaria'];ScriptApp.getProjectTriggers().filter(t=>handlers.includes(t.getHandlerFunction())).forEach(t=>ScriptApp.deleteTrigger(t));ScriptApp.newTrigger('HDK_sincronizacaoIncremental').timeBased().everyMinutes(5).create();ScriptApp.newTrigger('HDK_reprocessarPendencias').timeBased().everyMinutes(5).create();ScriptApp.newTrigger('HDK_reconciliacaoDiaria').timeBased().atHour(2).everyDays(1).create();}

function HDK_sincronizacaoIncremental(){const lock=LockService.getScriptLock();if(!lock.tryLock(1000))return{ok:false,motivo:'ocupado'};try{const props=PropertiesService.getScriptProperties(),state=HDK_stateMap_(),sales=listarTodasVendas_().map(HDK_fornoPayload_),changedSales=HDK_changed_('FORNO',sales,state),salesResult=HDK_sendChanged_('FORNO',changedSales,'HD_VENDAS_SCAN',state),sheet=SpreadsheetApp.openById(HDV_CONFIG.SINCRONIZACAO.PLANILHA_APONTAMENTOS_ID).getSheetByName(HDV_CONFIG.SINCRONIZACAO.ABA_APONTAMENTOS),last=Math.max(2,sheet.getLastRow()),start=Math.max(2,Number(props.getProperty('HDK_SCAN_CURSOR')||2));if(start>last)start=2;const count=Math.min(HDK.SCAN,last-start+1),items=HDK_lerApontamentos_(sheet,start,count),changed=HDK_changed_('APONTAMENTO',items,state),apResult=HDK_sendChanged_('APONTAMENTO',changed,'APONTAMENTOS_SCAN_5_MIN',state),success=salesResult.erros===0&&apResult.erros===0,next=success?(start+count>last?2:start+count):start,summary={at:new Date().toISOString(),ok:success,vendas_lidas:sales.length,vendas_enviadas:salesResult.enviados,apontamentos_lidos:items.length,apontamentos_enviados:apResult.enviados,erros:salesResult.erros+apResult.erros,proxima_linha:next};props.setProperties({HDK_SCAN_CURSOR:String(next),HDK_ULTIMA_SINCRONIZACAO:JSON.stringify(summary)});return summary;}finally{lock.releaseLock();}}

function HDK_reprocessarPendencias(){const lock=LockService.getScriptLock();if(!lock.tryLock(1000))return{ok:false,motivo:'ocupado'};try{const sheet=HDK_sheet_(HDK.QUEUE_SHEET,['IDEMPOTENCIA','ENTIDADE','ORIGEM','PAYLOAD','TENTATIVAS','PROXIMA_TENTATIVA','ERRO']);if(sheet.getLastRow()<=1)return{ok:true,processados:0};const rows=sheet.getRange(2,1,sheet.getLastRow()-1,7).getValues(),now=new Date(),remove=[],state=HDK_stateMap_();rows.forEach((row,index)=>{if(row[5] instanceof Date&&row[5]>now)return;try{const item=JSON.parse(row[3]),entity=String(row[1]),action=entity==='FORNO'?'sync-fornos-batch':'sync-apontamentos-batch';HDK_enviar_(action,[item],`REPROCESSO:${row[2]}`,`${row[0]}:tentativa:${Number(row[4])+1}`);HDK_commitState_(entity,[item],state);remove.push(index+2);}catch(error){const attempts=Number(row[4])+1,minutes=Math.min(1440,5*Math.pow(2,Math.min(attempts,8)));sheet.getRange(index+2,5,1,3).setValues([[attempts,new Date(Date.now()+minutes*60000),String(error).slice(0,1000)]]);}});remove.reverse().forEach(row=>sheet.deleteRow(row));return{ok:true,processados:remove.length,restantes:sheet.getLastRow()-1};}finally{lock.releaseLock();}}

function HDK_reconciliarSupabaseCompleto(origem){const lock=LockService.getScriptLock();if(!lock.tryLock(1000))return{ok:false,motivo:'ocupado'};const started=new Date();try{const state=HDK_stateMap_(),origin=origem||'RECONCILIACAO_MANUAL',sales=listarTodasVendas_().map(HDK_fornoPayload_),salesResult=HDK_sendChanged_('FORNO',sales,origin,state),sheet=SpreadsheetApp.openById(HDV_CONFIG.SINCRONIZACAO.PLANILHA_APONTAMENTOS_ID).getSheetByName(HDV_CONFIG.SINCRONIZACAO.ABA_APONTAMENTOS),totals={lidos:0,enviados:0,inseridos:0,atualizados:0,ignorados:0,erros:0};for(let start=2;start<=sheet.getLastRow();start+=HDK.SCAN){const items=HDK_lerApontamentos_(sheet,start,Math.min(HDK.SCAN,sheet.getLastRow()-start+1)),result=HDK_sendChanged_('APONTAMENTO',items,origin,state);totals.lidos+=items.length;totals.enviados+=result.enviados;totals.inseridos+=result.inseridos;totals.atualizados+=result.atualizados;totals.ignorados+=result.ignorados;totals.erros+=result.erros;}const summary={ok:salesResult.erros===0&&totals.erros===0,iniciadoEm:started.toISOString(),concluidoEm:new Date().toISOString(),vendas:{lidas:sales.length,...salesResult},apontamentos:totals};try{HDK_enviar_('reconciliation-summary',summary,origin,HDK_hash_({origin,started:summary.iniciadoEm}));}catch(error){summary.registroAuditoriaErro=String(error);}PropertiesService.getScriptProperties().setProperty('HDK_ULTIMA_RECONCILIACAO',JSON.stringify(summary));return summary;}finally{lock.releaseLock();}}
function HDK_reconciliacaoDiaria(){return HDK_reconciliarSupabaseCompleto('RECONCILIACAO_DIARIA');}

function HDK_statusIntegracao(){const props=PropertiesService.getScriptProperties(),queue=HDK_sheet_(HDK.QUEUE_SHEET,['IDEMPOTENCIA','ENTIDADE','ORIGEM','PAYLOAD','TENTATIVAS','PROXIMA_TENTATIVA','ERRO']);return{ultimaSincronizacao:JSON.parse(props.getProperty('HDK_ULTIMA_SINCRONIZACAO')||'null'),ultimaReconciliacao:JSON.parse(props.getProperty('HDK_ULTIMA_RECONCILIACAO')||'null'),cursor:Number(props.getProperty('HDK_SCAN_CURSOR')||2),pendencias:Math.max(0,queue.getLastRow()-1)};}


