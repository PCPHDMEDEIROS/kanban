/** HD Medeiros — varredura incremental e reprocessamento seletivo. Adicionar este arquivo. */
function HDK_instalarGatilhos(){const handlers=['HDK_sincronizacaoIncremental','HDK_reprocessarPendencias'];ScriptApp.getProjectTriggers().filter(t=>handlers.includes(t.getHandlerFunction())).forEach(t=>ScriptApp.deleteTrigger(t));ScriptApp.newTrigger('HDK_sincronizacaoIncremental').timeBased().everyMinutes(5).create();ScriptApp.newTrigger('HDK_reprocessarPendencias').timeBased().everyMinutes(5).create();}

function HDK_sincronizacaoIncremental(){const lock=LockService.getScriptLock();if(!lock.tryLock(1000))return{ok:false,motivo:'ocupado'};try{const props=PropertiesService.getScriptProperties(),state=HDK_stateMap_(),sales=listarTodasVendas_().map(HDK_fornoPayload_),changedSales=HDK_changed_('FORNO',sales,state),sentSales=HDK_sendChanged_('FORNO',changedSales,'HD_VENDAS_SCAN',state),sheet=SpreadsheetApp.openById(HDV_CONFIG.SINCRONIZACAO.PLANILHA_APONTAMENTOS_ID).getSheetByName(HDV_CONFIG.SINCRONIZACAO.ABA_APONTAMENTOS),last=Math.max(2,sheet.getLastRow()),start=Math.max(2,Number(props.getProperty('HDK_SCAN_CURSOR')||2));if(start>last)start=2;const count=Math.min(HDK.SCAN,last-start+1),items=HDK_lerApontamentos_(sheet,start,count),changed=HDK_changed_('APONTAMENTO',items,state),sent=HDK_sendChanged_('APONTAMENTO',changed,'APONTAMENTOS_SCAN_5_MIN',state),next=start+count>last?2:start+count;props.setProperties({HDK_SCAN_CURSOR:String(next),HDK_ULTIMA_SINCRONIZACAO:JSON.stringify({at:new Date().toISOString(),vendas_lidas:sales.length,vendas_enviadas:sentSales,apontamentos_lidos:items.length,apontamentos_enviados:sent,proxima_linha:next})});return{ok:true,vendasEnviadas:sentSales,apontamentosEnviados:sent,proximaLinha:next};}finally{lock.releaseLock();}}

function HDK_reprocessarPendencias(){const lock=LockService.getScriptLock();if(!lock.tryLock(1000))return{ok:false,motivo:'ocupado'};try{const sheet=HDK_sheet_(HDK.QUEUE_SHEET,['IDEMPOTENCIA','ENTIDADE','ORIGEM','PAYLOAD','TENTATIVAS','PROXIMA_TENTATIVA','ERRO']);if(sheet.getLastRow()<=1)return{ok:true,processados:0};const rows=sheet.getRange(2,1,sheet.getLastRow()-1,7).getValues(),now=new Date(),remove=[],state=HDK_stateMap_();rows.forEach((row,index)=>{if(row[5] instanceof Date&&row[5]>now)return;try{const item=JSON.parse(row[3]),entity=String(row[1]),action=entity==='FORNO'?'sync-fornos-batch':'sync-apontamentos-batch';HDK_enviar_(action,[item],`REPROCESSO:${row[2]}`,`${row[0]}:tentativa:${Number(row[4])+1}`);HDK_commitState_(entity,[item],state);remove.push(index+2);}catch(error){const attempts=Number(row[4])+1,minutes=Math.min(1440,5*Math.pow(2,Math.min(attempts,8)));sheet.getRange(index+2,5,1,3).setValues([[attempts,new Date(Date.now()+minutes*60000),String(error).slice(0,1000)]]);}});remove.reverse().forEach(row=>sheet.deleteRow(row));return{ok:true,processados:remove.length,restantes:sheet.getLastRow()-1};}finally{lock.releaseLock();}}

function HDK_reconciliarSupabaseCompleto(){const lock=LockService.getScriptLock();if(!lock.tryLock(1000))return{ok:false,motivo:'ocupado'};try{const state=HDK_stateMap_(),sales=listarTodasVendas_().map(HDK_fornoPayload_),changedSales=HDK_changed_('FORNO',sales,state),sentSales=HDK_sendChanged_('FORNO',changedSales,'RECONCILIACAO_MANUAL',state),sheet=SpreadsheetApp.openById(HDV_CONFIG.SINCRONIZACAO.PLANILHA_APONTAMENTOS_ID).getSheetByName(HDV_CONFIG.SINCRONIZACAO.ABA_APONTAMENTOS);let read=0,sent=0;for(let start=2;start<=sheet.getLastRow();start+=HDK.SCAN){const items=HDK_lerApontamentos_(sheet,start,Math.min(HDK.SCAN,sheet.getLastRow()-start+1)),changed=HDK_changed_('APONTAMENTO',items,state);read+=items.length;sent+=HDK_sendChanged_('APONTAMENTO',changed,'RECONCILIACAO_MANUAL',state);}return{ok:true,vendasLidas:sales.length,vendasEnviadas:sentSales,apontamentosLidos:read,apontamentosEnviados:sent};}finally{lock.releaseLock();}}

function HDK_statusIntegracao(){const props=PropertiesService.getScriptProperties(),queue=HDK_sheet_(HDK.QUEUE_SHEET,['IDEMPOTENCIA','ENTIDADE','ORIGEM','PAYLOAD','TENTATIVAS','PROXIMA_TENTATIVA','ERRO']);return{ultimaSincronizacao:JSON.parse(props.getProperty('HDK_ULTIMA_SINCRONIZACAO')||'null'),cursor:Number(props.getProperty('HDK_SCAN_CURSOR')||2),pendencias:Math.max(0,queue.getLastRow()-1)};}

